{
  "name": "cron-explain-ja",
  "version": "1.2.1",
  "description": "cron式と日本語を相互変換するライブラリ / CLI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cron-ja": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "dev:site": "vite",
    "build:site": "vite build",
    "preview:site": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.site.json",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "cron",
    "crontab",
    "japanese",
    "日本語",
    "schedule",
    "parser",
    "cli"
  ],
  "author": "buko106",
  "license": "MIT",
  "homepage": "https://www.buko106.tokyo/cron-explain-ja/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buko106/cron-explain-ja.git"
  },
  "bugs": {
    "url": "https://github.com/buko106/cron-explain-ja/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cron-parser": "^5.10.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
